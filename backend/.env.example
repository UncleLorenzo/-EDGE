# ─────────────────────────────────────────────────────────────────────────────
# $EDGE backend — environment. Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Service
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# System of record
DATABASE_URL=postgres://user:pass@localhost:5432/edge
# Durable queue for signals -> copies (keeper)
REDIS_URL=redis://localhost:6379

# Polymarket / Polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# Chain id 137 (Polygon mainnet)
CHAIN_ID=137

# ── FEES (token-decoupled) ───────────────────────────────────────────────────
# Charged in USDC, captured NATIVELY via Polymarket Builder Codes (no custody /
# router needed). Decision: 80 bps (0.80%) — undercuts the ~1% genre norm + PolyGun's
# 1%, within the 100 bps builder taker cap. See copytrade/06-FEE-MODEL-DECISION.md.
FEE_BPS=80
# Our Polymarket builder code — the order attribution that collects the fee.
BUILDER_CODE=
# Referral share to the referrer (genre norm 25-35%).
REFERRAL_SHARE_PCT=30
# Charge fees on manual one-click too? (default: yes — bots charge from day one)
FEE_ON_MANUAL=true
FEE_ON_AUTOCOPY=true
# Treasury address that receives USDC fees while tokenomics are OFF
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ── TOKENOMICS SEAM (default OFF — "drop the hammer" later) ───────────────────
# When false: 100% of fees -> treasury, flat tiers, no $EDGE anywhere.
# When true:  fee split routes a % to buy-&-burn $EDGE, hold-$EDGE tiers enforced.
TOKENOMICS_ENABLED=false
# Only read when TOKENOMICS_ENABLED=true:
BURN_SPLIT_PCT=50
EDGE_TOKEN_ADDRESS=
BURN_ADDRESS=0x000000000000000000000000000000000000dEaD

# ── CUSTODY (Day-0 decision — vendor TBD) ────────────────────────────────────
# A = connect-wallet (non-custodial), B = managed MPC, C = AA session keys
DEFAULT_CUSTODY_MODEL=A
# Model B vendor creds (Turnkey / Privy) — leave blank until vendor chosen
MPC_PROVIDER=
MPC_API_KEY=
MPC_API_SECRET=

# ── VENUE SEGMENTATION (copytrade/07) — both OFF until go-live ───────────────
# Non-US managed builder-fee bot (partner-hosted, International):
VENUE_INTL_ENABLED=false
# US referral/IB light path (EDGE-hosted, Polymarket US):
VENUE_US_ENABLED=false
US_REFERRAL_CODE=
# Consumer markets are on polymarket.com (geo-routes US users); polymarket.us is just a landing page.
US_SITE_URL=https://polymarket.com

# ── SIGNAL SOURCE (EDGE's existing sharp feed — the moat) ────────────────────
EDGE_FEED_URL=https://www.thepolyedge.com/api/whales/sharp
SIGNAL_POLL_MS=4000

# ── SAFETY ───────────────────────────────────────────────────────────────────
# Global kill switch — when true, the keeper places NO new orders.
KILL_SWITCH=false
# Keeper starts in dry-run (logs intended copies, places nothing) until flipped.
KEEPER_DRY_RUN=true
GLOBAL_MAX_OPEN_EXPOSURE_USD=100000

# ── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
