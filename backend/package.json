{
  "name": "edge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on money layer for the $EDGE trading & copy-trading suite (token-decoupled).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:init": "node --import tsx scripts/db-init.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "spike:clob": "node --import tsx scripts/clob-spike.ts"
  },
  "dependencies": {
    "@polymarket/clob-client": "^4.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "fastify": "^4.28.0",
    "grammy": "^1.30.0",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
